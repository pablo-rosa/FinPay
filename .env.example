# Local development only. Do not reuse these values outside your machine.
POSTGRES_DB=finpay
POSTGRES_USER=finpay
POSTGRES_PASSWORD=finpay_dev
POSTGRES_PORT=5433

# Generate a random value of at least 32 bytes before starting the backend.
DB_URL=jdbc:postgresql://localhost:5433/finpay
DB_USERNAME=finpay
DB_PASSWORD=finpay_dev
JWT_SECRET=

# Optional local test USER only. Keep disabled outside local development.
FINPAY_BOOTSTRAP_ENABLED=true
# Leave admin credentials empty here; configure your private local admin in .env.
FINPAY_BOOTSTRAP_ADMIN_EMAIL=
FINPAY_BOOTSTRAP_ADMIN_PASSWORD=
FINPAY_BOOTSTRAP_USER_EMAIL=user@finpay.local
FINPAY_BOOTSTRAP_USER_PASSWORD=FinPayUser2026!

# Portfolio demo: isolated session accounts with fictitious funds.
FINPAY_DEMO_ENABLED=true
FINPAY_DEMO_FUNDED_AMOUNT=10000.00
FINPAY_DEMO_RATE_LIMIT_MAX_SESSIONS=10
FINPAY_DEMO_RATE_LIMIT_WINDOW=PT1H
